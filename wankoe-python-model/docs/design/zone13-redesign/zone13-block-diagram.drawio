        <mxCell id="ce12" value="0/3.75 — 27.7 t/h&#10;(linking conveyor)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1f2a44;fontColor=#1f2a44;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sca" target="scb"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce13" value="sliver 1.5/2 — 7.0 t/h&#10;REGRIND to RC.2 (client 2026-08-14)&#10;internal recycle stream, NOT a product" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#c62828;fontColor=#c62828;dashed=1;fontSize=10;exitX=1;exitY=0.3;entryX=1;entryY=1;" edge="1" parent="1" source="scb" target="rc2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce14" value="0/1.5 fines — 9.2 t/h" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1f2a44;fontColor=#1f2a44;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="scb" target="c-sp36"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce15" value="UltraFin 0.05 t/h" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1f2a44;fontColor=#1f2a44;fontSize=10;" edge="1" parent="1" source="c-sp36" target="c-cl38"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2e7d32;fontSize=10;" edge="1" parent="1" source="c-cl38" target="c-bi50"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce17" value="FeedLime fines 9.11 t/h (dry, 0/1.5)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1f2a44;fontColor=#1f2a44;fontSize=10;exitX=0.3;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="c-sp36" target="c-be40"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2e7d32;fontSize=10;" edge="1" parent="1" source="c-be40" target="c-bi6070"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="c-note-tags" value="* STUDY TAGS — new machines of the C1 redesign, no PFD reference numbers exist yet. Screen arrangement per client arbitration 2026-08-14: 2+2 — SC.A carries the recycle cuts (8/3.75), SC.B the product cuts (2/1.5), both critical decks in favorable position. Final numbers to be assigned in the plant codification series on adoption (proposal: SC.A takes the SN.21 slot, SC.B a new SN.2x, RC.1/RC.2 new CR.2x tags replacing ML.26; formal codification by NACO). All other tags are the verified as-built references (unchanged equipment)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=10;fontColor=#0d47a1;align=left;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="20" y="390" width="345" height="125" as="geometry" />
        </mxCell>
        <mxCell id="c-note-perf" value="BASE SCENARIO (client 2026-08-14): single RC.2 unit, sliver regrind, dryer throttled to 22.3 t/h wet.&#10;grits 11.56 t/h (55.8 %) — MAX CAPACITY 69 300 t/y at the 6 000 h ceiling&#10;total-fines/grits ratio 0.79 (D3 firm 1.25 AND objective 1.0 MET)&#10;grits QC: below 2 mm 13.6 % / above 4 mm 2.6 % (D6 MET, margin 1.4 pts — vendor test to confirm)&#10;40 kt/y = 3 461 h (57.7 %) — EXTENSION (2nd RC.2 unit, full dryer): 16.66 t/h, 80 kt/y in 4 802 h&#10;Open point: RC.1 purchase spec 29 or 32 t/h (32 covers full-dryer extension + quarry feed)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=10;fontColor=#1b5e20;align=left;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="20" y="530" width="345" height="130" as="geometry" />
        </mxCell>
        <mxCell id="c-note-naming" value="STREAM NAMING (client rule 2026-08-14): zone 1.3 makes DRY products only — FeedLime grits 2/4, FeedLime fines 0/1.5, UltraFin. AgLime is a WET zone-1.2 product; zone 1.3 NEVER produces AgLime. The commercial redirect of the FeedLime-fines surplus into the AgLime SALES channel happens at loadout, not in this flowsheet." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#f9a825;fontSize=10;fontColor=#795500;align=left;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="20" y="665" width="345" height="95" as="geometry" />
        </mxCell>
        <mxCell id="c-footer" value="Engine run: run_scenario, zone_1_3_variant = c1, SC.B sliver_routing = regrind (client arbitration 2026-08-14; two-position diverter keeps 'extract' selectable). C1 is a STUDY variant — the as-built circuit remains the model default until client adoption. Dryer chain auxiliaries (BU.04, FI.05/FN.06) unchanged, omitted for clarity. Design basis: docs/design/zone13-redesign/design-basis.md." style="text;html=1;fontSize=9;fontColor=#5a5f68;align=left;" vertex="1" parent="1">
          <mxGeometry x="20" y="780" width="1350" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
